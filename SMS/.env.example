# Absolute path: SMS/.env.example
# Copy to SMS/.env and fill in real values. Never commit .env.

SECRET_KEY=change-me-to-a-random-50-char-string
TIME_ZONE=Africa/Nairobi
# Development accepts localhost and any school.localhost subdomain.
TENANT_ROOT_DOMAIN=localhost
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
CSRF_TRUSTED_ORIGINS=

# Production example:
# TENANT_ROOT_DOMAIN=example.com
# ALLOWED_HOSTS=your-app.onrender.com,example.com,.example.com
# CSRF_TRUSTED_ORIGINS=https://example.com,https://*.example.com

# Supabase PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Supabase project config (REST/GraphQL API — not used for Storage; see below)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage (Phase 23, spec §41). These are DEDICATED S3-protocol
# keys — generate them in the Supabase dashboard under
# Storage -> S3 Connection. They are NOT the same as SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY above (those authenticate a different API).
# Required in production (SMS.settings.prod refuses to start without
# them); optional in development (local filesystem storage is used
# unless USE_SUPABASE_STORAGE_IN_DEV=True).
SUPABASE_STORAGE_ENDPOINT_URL=https://xxxxx.supabase.co/storage/v1/s3
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET_NAME=sms-media
SUPABASE_STORAGE_REGION=us-east-1
SUPABASE_STORAGE_URL_EXPIRE_SECONDS=3600
USE_SUPABASE_STORAGE_IN_DEV=False

# Redis (Phase 24, spec §41). Powers cross-worker-safe rate limiting
# (login lockout, DRF throttling). Optional — unset falls back to
# Django's in-process cache, fine for a single-worker dev server but NOT
# safe for a multi-worker production deployment (see settings/base.py).
REDIS_URL=

# Production email (used only by SMS.settings.prod)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Attendance SMS notifications. Suggested providers: Africa's Talking (Kenya)
# or Twilio. Use the provider's HTTPS send endpoint and bearer/API token.
SMS_PROVIDER=africastalking
# Generic JSON/Bearer gateway (used when SMS_PROVIDER=http)
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER_ID=
# Africa's Talking (recommended for Kenya)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_API_URL=https://api.africastalking.com/version1/messaging
# Twilio alternative
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_ATTENDANCE_NOTIFICATIONS=True
